# ============================================================
# GENERAL
# ============================================================

TZ=America/Sao_Paulo


# ============================================================
# BRAIN API
# ============================================================

BRAIN_API_KEY=change_me
BRAIN_API_HOST=0.0.0.0
BRAIN_API_PORT=8000

SEARCH_LIMIT=20
MAX_RESULTS=5

MIN_ADJUSTED_SCORE=0.82
DUPLICATE_SCORE_THRESHOLD=0.87
MEMORY_CANDIDATE_THRESHOLD=0.80
MEMORY_NOTE_MAX_CHARS=30000


# ============================================================
# VAULT
# ============================================================

VAULT_PATH=/vault


# ============================================================
# QDRANT
# ============================================================

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=second_brain


# ============================================================
# EMBEDDINGS
# ============================================================

EMBEDDING_MODEL=intfloat/multilingual-e5-base

CHUNK_SIZE=1200
CHUNK_OVERLAP=200

RECREATE_COLLECTION=false


# ============================================================
# GEMINI
# ============================================================

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite


# ============================================================
# POSTGRESQL
# ============================================================

POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432


# ============================================================
# N8N
# ============================================================

N8N_ENCRYPTION_KEY=generate_a_strong_random_key

N8N_HOST=n8n.internal.example.com
N8N_PROTOCOL=https
N8N_PORT=5678

N8N_EDITOR_BASE_URL=https://n8n.internal.example.com/
N8N_WEBHOOK_URL=https://hooks.example.com/

N8N_PROXY_HOPS=1


# ============================================================
# TELEGRAM
# ============================================================

TELEGRAM_BOT_TOKEN=your_telegram_bot_token


# ============================================================
# TRAEFIK / HOSTS
# ============================================================

PUBLIC_WEBHOOK_HOST=hooks.example.com
PRIVATE_N8N_HOST=n8n.internal.example.com

TRAEFIK_NETWORK=proxy
TRAEFIK_CERT_RESOLVER=myresolver

N8N_ALLOWED_NETWORKS=192.168.1.0/24,10.8.0.0/24


# ============================================================
# STORAGE
# ============================================================

QDRANT_DATA_PATH=./data/qdrant
POSTGRES_DATA_PATH=./data/postgres
N8N_DATA_PATH=./data/n8n
HF_MODELS_PATH=./data/models/huggingface


# ============================================================
# SECURITY
# ============================================================

# Never commit your real .env file.
# Copy this file:
#
# cp .env.example .env
#
# Then replace all example values with your own credentials.