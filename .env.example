# ============================================================
# GENERAL
# ============================================================

TZ=America/Sao_Paulo


# ============================================================
# BRAIN API
# ============================================================

BRAIN_API_KEY=change_me
BRAIN_API_PORT=8000

SEARCH_LIMIT=20
MAX_RESULTS=5

MIN_ADJUSTED_SCORE=0.82
DUPLICATE_SCORE_THRESHOLD=0.87
MEMORY_CANDIDATE_THRESHOLD=0.80
MEMORY_NOTE_MAX_CHARS=30000


# ============================================================
# VAULT
# ============================================================

# Path inside the containers
VAULT_PATH=/vault

# Path on the Docker host
VAULT_DATA_PATH=../data/vault


# ============================================================
# QDRANT
# ============================================================

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=second_brain

QDRANT_DATA_PATH=../data/qdrant


# ============================================================
# EMBEDDINGS
# ============================================================

EMBEDDING_MODEL=intfloat/multilingual-e5-base

CHUNK_SIZE=1200
CHUNK_OVERLAP=200

RECREATE_COLLECTION=false

HF_MODELS_PATH=../data/models/huggingface


# ============================================================
# GEMINI
# ============================================================

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite


# ============================================================
# POSTGRESQL
# ============================================================

POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change_me

POSTGRES_HOST=postgres
POSTGRES_PORT=5432

POSTGRES_DATA_PATH=../data/postgres


# ============================================================
# N8N
# ============================================================

N8N_ENCRYPTION_KEY=generate_a_strong_random_key

N8N_HOST=n8n.internal.example.com
N8N_PROTOCOL=https
N8N_PORT=5678

N8N_EDITOR_BASE_URL=https://n8n.internal.example.com/
N8N_WEBHOOK_URL=https://hooks.example.com/

N8N_PROXY_HOPS=1

N8N_DATA_PATH=../data/n8n


# ============================================================
# TRAEFIK / HOSTS
# ============================================================

PUBLIC_WEBHOOK_HOST=hooks.example.com
PRIVATE_N8N_HOST=n8n.internal.example.com

TRAEFIK_NETWORK=proxy
TRAEFIK_CERT_RESOLVER=myresolver

N8N_ALLOWED_NETWORKS=192.168.1.0/24,10.8.0.0/24


# ============================================================
# OPTIONAL / INTEGRATIONS
# ============================================================

# Telegram credentials are preferably configured directly
# inside n8n Credentials instead of being stored here.
#
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token


# ============================================================
# SECURITY
# ============================================================

# Never commit your real .env file.
#
# Create it with:
#
# cp .env.example .env
#
# Then replace all example values with your own credentials.
#
# Recommended:
#
# - Use strong random values for BRAIN_API_KEY
# - Use a strong POSTGRES_PASSWORD
# - Keep N8N_ENCRYPTION_KEY stable after first use
# - Never commit API keys, bot tokens or private credentials