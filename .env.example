# Brain API
BRAIN_API_KEY=change_me
BRAIN_API_HOST=0.0.0.0
BRAIN_API_PORT=8000

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=second_brain

# Embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Vault
VAULT_PATH=/vault

# PostgreSQL / n8n
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# n8n
N8N_ENCRYPTION_KEY=generate_a_strong_random_key
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
N8N_PORT=5678
N8N_EDITOR_BASE_URL=https://n8n.example.com/
N8N_WEBHOOK_URL=https://hooks.example.com/
N8N_PROXY_HOPS=1

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Hosts
PUBLIC_WEBHOOK_HOST=hooks.example.com
PRIVATE_N8N_HOST=n8n.internal.example.com

# Never commit your real .env file.
